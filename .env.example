# Copy this to .env.local for local dev, and set the same keys in your
# Vercel project's Environment Variables for production.

# Random secret used to sign admin session tokens. Generate with:
#   openssl rand -hex 32
ADMIN_SECRET=

# Password required to log into /admin
ADMIN_PASSWORD=

# GitHub repo the admin panel commits content/image changes to
GITHUB_OWNER=Robiin28
GITHUB_REPO=update
GITHUB_BRANCH=main

# Fine-grained GitHub Personal Access Token scoped to the repo above,
# with "Contents: Read and write" permission.
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Public site URL, used in metadata/Open Graph tags
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Use the local JSON files as the data source
NEXT_PUBLIC_DATABASE_MODE=json
